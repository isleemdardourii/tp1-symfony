{% extends 'base.html.twig' %}

{% block title %}Mes tâches{% endblock %}

{% block body %}

    <h1>Ma liste de tâches</h1>

    <a href="{{ path('app_tache_ajouter') }}">+ Ajouter une tâche</a>

    <hr>

    {% if taches is empty %}
        <p>Aucune tâche disponible.</p>
    {% else %}
        {% for tache in taches %}
            <div>
                <h3>
                    <a href="{{ path('app_tache_detail', {'id': tache.id}) }}">
                        {{ tache.titre }}
                    </a>
                </h3>

                {% if tache.terminee %}
                    <p style="text-decoration: line-through;">
                        {{ tache.titre }} — Terminée ✅
                    </p>
                {% else %}
    <p>En cours ⏳</p>

    <a href="{{ path('app_tache_terminer', {'id': tache.id}) }}"
       class="btn btn-success btn-sm">
        ✅ Terminer cette tâche
    </a>
{% endif %}

            </div>
            <hr>
        {% endfor %}
    {% endif %}

{% endblock %}
