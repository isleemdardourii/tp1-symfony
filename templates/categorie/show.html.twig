{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>{{ categorie.nom }}</h1>

    <p>
        {{ categorie.description ?: 'Aucune description disponible.' }}
    </p>

    <h3>Articles de cette catégorie</h3>

    {% if categorie.articles|length > 0 %}
        <ul>
            {% for article in categorie.articles %}
                <li>
                    <a href="{{ path('app_article_detail', {id: article.id}) }}">
                        {{ article.titre }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucun article dans cette catégorie.</p>
    {% endif %}

    <a href="{{ path('app_categories') }}" class="btn btn-secondary">
        Retour aux catégories
    </a>

    <a href="{{ path('app_categorie_modifier', {id: categorie.id}) }}"
       class="btn btn-primary">
        Modifier
    </a>
</div>
{% endblock %}
